<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="label" type="String" default="Custom Checkbox" description="Label for the checkbox" />
            <property name="isChecked" type="Boolean" default="false" description="Initial checked state of the checkbox" />
            <property name="defaultBackground" type="String" default="#f0f0f0" description="Background color when unchecked" />
            <property name="checkedBackground" type="String" default="#28a745" description="Background color when checked" />
            <property name="name" type="String" description="Name attribute for form association" />
            <property name="value" type="String" description="Value attribute for form submission" />
            <property name="disabled" type="Boolean" default="false" description="Disables the checkbox" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>